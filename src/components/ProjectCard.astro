---
interface StackItem {
  name: string;
  icon: string;
}

interface Props {
  number: string;
  category: string;
  year: string;
  title: string;
  description: string;
  image: string;
  github: string;
  preview: string;
  stack: StackItem[];
}

const {
  number,
  category,
  year,
  title,
  description,
  image,
  github,
  preview,
  stack,
} = Astro.props;
---

<article class="project-card interactive-el">
  <div
    class="font-label-mono text-on-surface-variant mb-4 flex justify-between"
  >
    <span>{number} / {category}</span>
    <span>{year}</span>
  </div>
  <div class="project-image-container ghost-edge">
    <img src={image} alt={title} />
  </div>
  <h4 class="font-headline-md mb-2">{title}</h4>

