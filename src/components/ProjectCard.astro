---
interface StackItem {
  name: string;
  icon: string;
}

interface Props {
  number: string;
  category: string;
  year: string;
  title: string;
  description: string;
  image: string;
  github: string;
  preview: string;
  stack: StackItem[];
}

const { number, category, year, title, description, image, github, preview, stack } = Astro.props;
---
<article class="project-card interactive-el">
  <div class="font-label-mono text-on-surface-variant mb-4 flex justify-between">
    <span>{number} / {category}</span>
    <span>{year}</span>
  </div>
  <div class="project-image-container ghost-edge">
    <img src={image} alt={title} />
  </div>
  <h4 class="font-headline-md mb-2">{title}</h4>
  
  <div class="flex flex-wrap gap-2 mb-4">
    {stack.map((item) => (
      <div class="badge-tech">
        {item.icon === 'react' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="2" /><path d="M12 7c2.76 0 5.33.48 7.38 1.32C21.28 9.1 22 10.37 22 12s-.72 2.9-2.62 3.68C17.33 16.52 14.76 17 12 17s-5.33-.48-7.38-1.32C2.72 14.9 2 13.63 2 12s.72-2.9 2.62-3.68C6.67 7.48 9.24 7 12 7z" /><path d="M12 7c-2.76 0-5.33.48-7.38 1.32C2.72 9.1 2 10.37 2 12s.72 2.9 2.62 3.68C6.67 16.52 9.24 17 12 17s5.33-.48 7.38-1.32C21.28 14.9 22 13.63 22 12s-.72-2.9-2.62-3.68C17.33 7.48 14.76 7 12 7z" transform="rotate(60 12 12)" /><path d="M12 7c-2.76 0-5.33.48-7.38 1.32C2.72 9.1 2 10.37 2 12s.72 2.9 2.62 3.68C6.67 16.52 9.24 17 12 17s5.33-.48 7.38-1.32C21.28 14.9 22 13.63 22 12s-.72-2.9-2.62-3.68C17.33 7.48 14.76 7 12 7z" transform="rotate(120 12 12)" /></svg>
        )}
        {item.icon === 'nodejs' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8.66 5v10L12 22l-8.66-5V7L12 2z" /><path d="M12 7v10" /><path d="M8 9h8" /></svg>
        )}
        {item.icon === 'css' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 2L18.5 22L12 24L5.5 22L4 2L20 2Z" /><path d="M12 5V19L17 17.5L18 5H12Z" /></svg>
        )}
        {item.icon === 'express' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z" /></svg>
        )}
        {item.icon === 'prisma' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5" /></svg>
        )}
        {item.icon === 'postgresql' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5c-4.42 0-8 3.58-8 8 0 1.66.5 3.19 1.35 4.46L4 21l3.54-1.35c1.27.85 2.8 1.35 4.46 1.35 4.42 0 8-3.58 8-8s-3.58-8-8-8z" /><path d="M9 13a1 1 0 1 0 2 0 1 1 0 1 0-2 0" /></svg>
        )}
        {item.icon === 'tailwind' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 16s4.5-1 4.5-4.5C6.5 8 2 7 2 7s4.5-1 4.5-4.5C6.5 1 11 2 11 2s4.5 1 4.5 4.5c0 3.5-4.5 4.5-4.5 4.5s4.5 1 4.5 4.5c0 3.5-4.5 4.5-4.5 4.5s-4.5 1-4.5-4.5c0-3.5 4.5-4.5 4.5-4.5s-4.5-1-4.5-4.5" /></svg>
        )}
        {item.icon === 'cpp' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l8.66 5v10L12 22l-8.66-5V7L12 2z" /><path d="M9 8a4 4 0 100 8" /><path d="M14 12h4m-2-2v4" /></svg>
        )}
        {item.icon === 'qt' && (
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8" /><path d="M17 17l4 4" /></svg>
        )}
        <span class="badge-text">{item.name}</span>
      </div>
    ))}
  </div>

  <p class="font-body-md text-on-surface-variant mb-6">{description}</p>
  
  <div class="flex gap-4">
    <a href={github} target="_blank" class="badge-action interactive-el no-underline">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      <span class="badge-text">CODE</span>
    </a>
    <a href={preview} target="_blank" class="badge-action interactive-el no-underline">
      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
      <span class="badge-text">PREVIEW</span>
    </a>
  </div>
</article>

<style>
  .no-underline {
    text-decoration: none;
  }
  
  .badge-tech, .badge-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    border-radius: var(--radius-full);
    transition: all 0.3s ease;
  }

  .badge-tech {
    padding: 4px 10px;
    background-color: rgba(13, 28, 50, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    color: var(--color-on-surface-variant);
  }

  .badge-tech:hover {
    background-color: rgba(13, 28, 50, 0.9);
    color: var(--color-primary);
    border-color: rgba(201, 198, 197, 0.2);
  }

  .badge-action {
    padding: 8px 16px;
    background-color: #030d25;
    border: 1px solid rgba(100, 255, 218, 0.2);
    color: var(--color-on-surface);
  }

  .badge-action:hover {
    background-color: #0a192f;
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .badge-text {
    font-family: 'JetBrains Mono', monospace;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.05em;
    line-height: 1;
    text-transform: uppercase;
  }

  .badge-tech .badge-text {
    font-size: 9px;
  }

  svg {
    display: block;
    flex-shrink: 0;
  }
</style>