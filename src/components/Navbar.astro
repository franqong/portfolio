<script>
  const logoContainer = document.getElementById('logo-container');
  const navLinks = document.querySelectorAll('.nav-link');
  
  const themeToggle = document.getElementById('theme-toggle');
  const moonIcon = document.getElementById('moon-icon');
  const sunIcon = document.getElementById('sun-icon');

  const langToggle = document.getElementById('lang-toggle');
  const langEsIcon = document.getElementById('lang-es-icon');
  const langEnIcon = document.getElementById('lang-en-icon');

  themeToggle?.addEventListener('click', () => {
    const isDark = moonIcon?.classList.contains('visible');
    if (isDark) {
      moonIcon?.classList.remove('visible');
      sunIcon?.classList.add('visible');
    } else {
      sunIcon?.classList.remove('visible');
      moonIcon?.classList.add('visible');
    }
  });

  langToggle?.addEventListener('click', () => {
    const isEs = langEsIcon?.classList.contains('visible');
    if (isEs) {
      langEsIcon?.classList.remove('visible');
      langEnIcon?.classList.add('visible');
    } else {
      langEnIcon?.classList.remove('visible');
      langEsIcon?.classList.add('visible');
    }
  });

  logoContainer?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    history.replaceState(null, '', window.location.pathname);
  });

  navLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href')?.substring(1);
      if (targetId) {
        const targetElement = document.getElementById(targetId);
        if (targetElement) {
          window.scrollTo({
            top: targetElement.offsetTop - 80,
            behavior: 'smooth'
          });
          history.replaceState(null, '', window.location.pathname);
        }
      }
    });
  });
</script>

<style>
  .icon-toggle-container {
    position: relative;
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-wrapper {
    position: absolute;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.4s ease;
    transform: scale(0.8);
    pointer-events: none;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .icon-wrapper.visible {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }
</style>