---
import BaseLayout from "../layouts/BaseLayout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    number: "01",
    category: "RED SOCIAL",
    year: "2025 - PRESENTE",
    title: "Penta",
    description:
      "Plataforma social diseñada para que los amantes de la música descubran, comenten y compartan la música que les gusta. Ofrece un espacio específico para que aficionados, críticos y artistas conecten a través de su pasión compartida por la música.",
    image: "/public/projects/penta.webp",
    github: "https://github.com/franqong/penta",
    preview: "#",
    stack: [
      { name: "React", icon: "react" },
      { name: "Node.js", icon: "nodejs" },
      { name: "CSS", icon: "css" },
      { name: "Express", icon: "express" },
      { name: "Prisma", icon: "prisma" },
      { name: "PostgreSQL", icon: "postgresql" },
    ],
  },
  {
    number: "02",
    category: "ESTACIÓN DE COMPOSICIÓN MUSICAL",
    year: "2025 - PRESENTE",
    title: "Penta Band",
    description:
      "Aplicación de escritorio independiente y de código abierto diseñada como un espacio de trabajo específico para la composición musical. Se trata de un proyecto complementario a «Penta», una red social musical basada en la web, cuyo objetivo es proporcionar a los compositores un conjunto completo de herramientas para su proceso creativo, desde las ideas iniciales hasta las piezas terminadas. La visión a largo plazo incluye una profunda integración con la plataforma social Penta, lo que permitirá compartir y colaborar sin interrupciones.",
    image: "/public/projects/penta-band.webp",
    github: "https://github.com/franqong/penta-band",
    preview: "#",
    stack: [
      { name: "C++", icon: "cpp" },
      { name: "Qt", icon: "qt" },
    ],
  },
  {
    number: "03",
    category: "GESTOR DE STOCK",
    year: "2026 - PRESENTE",
    title: "Orestes",
    description:
      "Plataforma web full-stack en desarrollo, construida con una arquitectura moderna y escalable. El proyecto se centra en la gestión eficiente de datos, manteniendo una separación estricta entre el cliente y el servidor para garantizar un desarrollo colaborativo ordenado.",
    image: "/public/projects/orestes.webp",
    github: "https://github.com/caudex-nox/orestes",
    preview: "#",
    stack: [
      { name: "React", icon: "react" },
      { name: "Node.js", icon: "nodejs" },
      { name: "Tailwind", icon: "tailwind" },
      { name: "Express", icon: "express" },
      { name: "Prisma", icon: "prisma" },
      { name: "PostgreSQL", icon: "postgresql" },
    ],
  },
];
---

<BaseLayout title="franqong | Portfolio">
  <Navbar />

  <main class="container" style="padding-top: 96px; padding-bottom: 64px;">
    <section class="section" id="about">
      <div
        class="flex flex-col md:flex-row gap-8 items-start max-w-4xl mx-auto"
      >
        <div class="flex flex-col items-center gap-4">
          <div class="avatar">
            <img src="/public/me.webp" alt="Headshot" />
          </div>
          <div class="badge-available w-max">
            <span class="dot-ping"></span>
            <span
              class="font-label-mono"
              style="font-size: 10px; white-space: nowrap;"
              >DISPONIBLE PARA TRABAJAR</span
            >
          </div>
        </div>

        <div class="flex-1 mt-4">
          <h2 class="font-label-mono text-primary mb-6 interactive-el">
            Franco Garcia
          </h2>
          <h3 class="font-headline-md mb-8">
            Desarrollador de software de alto y bajo nivel.
          </h3>
          <div class="flex flex-col gap-4 font-label-mono text-primary">
            <a
              href="https://www.linkedin.com/in/franco-garcia/"
              target="_blank"
              class="nav-link interactive-el flex items-center gap-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"
                ></path><rect width="4" height="12" x="2" y="9"></rect><circle
                  cx="4"
                  cy="4"
                  r="2"></circle></svg
              >
              LinkedIn
            </a>
            <a
              href="https://github.com/franqong"
              target="_blank"
              class="nav-link interactive-el flex items-center gap-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
                ></path><path d="M9 18c-4.51 2-5-2-7-2"></path></svg
              >
              GitHub
            </a>
            <a
              href="mailto:garciafranco1998@gmail.com"
              target="_blank"
              class="nav-link interactive-el flex items-center gap-2"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><rect width="20" height="16" x="2" y="4" rx="2"></rect><path
                  d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg
              >
              Email
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="experiencia">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-label-mono text-primary mb-12 interactive-el">
          EXPERIENCIA PROFESIONAL
        </h2>
        <div class="flex flex-col gap-12">
          <div class="flex flex-col md:grid md:grid-cols-4 gap-4">
            <div class="font-label-mono text-on-surface-variant pt-1">
              2026 — PRESENTE
            </div>
            <div class="md:col-span-3">
              <h4 class="font-headline-md mb-2" style="font-size: 24px;">
                Full Stack Web Developer
              </h4>
              <p class="font-body-md text-on-surface-variant">
                Caudex
              </p>
            </div>
          </div>

          <div class="staff-line" style="opacity: 0.5;"></div>

          <div class="flex flex-col md:grid md:grid-cols-4 gap-4">
            <div class="font-label-mono text-on-surface-variant pt-1">
              2024
            </div>
            <div class="md:col-span-3">
              <h4 class="font-headline-md mb-2" style="font-size: 24px;">
                Ventas & Appointment Setting
              </h4>
              <p class="font-body-md text-on-surface-variant">
                Firebrand Agency
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="proyectos">
      <div class="max-w-4xl mx-auto">
        <div class="mb-16">
          <h2 class="font-label-mono text-primary mb-2 interactive-el">
            PROYECTOS DESTACADOS
          </h2>
          {/* <h3 class="font-headline-md">Frequencies</h3> */}
        </div>

        <div class="project-grid">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
      </div>
    </section>

    <section class="section" id="sobre-mi">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-label-mono text-primary mb-12 interactive-el">
          SOBRE MÍ
        </h2>
        <h3 class="font-headline-md mb-8">
          Full Stack Web & Desktop Developer
        </h3>
        <div class="flex flex-col gap-6 font-body-lg text-on-surface-variant">
          <p>
            Estudiante en Tecnicatura en Desarrollo de Software, con formación
            en desarrollo web Full Stack y una fuerte orientación práctica
            basada en proyectos reales.
          </p>
          <p>
            Trabajo activamente en proyectos propios de desarrollo web y
            software de escritorio, además de colaborar en un proyecto web en
            equipo, lo que me permite fortalecer habilidades técnicas y trabajo
            colaborativo.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
