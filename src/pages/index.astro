---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectCard from "../components/ProjectCard.astro";

const isAvailableForWork = true; // Cambiar a false para mostrar el estado "Actualmente trabajando"

const projects = [
  {
    number: "01",
    categoryKey: "penta.cat",
    yearKey: "penta.year",
    title: "Penta",
    descriptionKey: "penta.desc",
    image: "/projects/penta.webp",
    github: "https://github.com/franqong/penta",
    preview: "#",
    stack: [
      { name: "React", icon: "react" },
      { name: "Node.js", icon: "nodejs" },
      { name: "CSS", icon: "css" },
      { name: "Express", icon: "express" },
      { name: "Prisma", icon: "prisma" },
      { name: "PostgreSQL", icon: "postgresql" },
    ],
  },
  {
    number: "02",
    categoryKey: "pentaband.cat",
    yearKey: "pentaband.year",
    title: "Penta Band",
    descriptionKey: "pentaband.desc",
    image: "/projects/penta-band.webp",
    github: "https://github.com/franqong/penta-band",
    preview: "#",
    stack: [
      { name: "C++", icon: "cpp" },
      { name: "Qt", icon: "qt" },
    ],
  },
  {
    number: "03",
    categoryKey: "orestes.cat",
    yearKey: "orestes.year",
    title: "Orestes",
    descriptionKey: "orestes.desc",
    image: "/projects/orestes.webp",
    github: "https://github.com/caudex-nox/orestes",
    preview: "#",
    stack: [
      { name: "React", icon: "react" },
      { name: "Node.js", icon: "nodejs" },
      { name: "Tailwind", icon: "tailwind" },
      { name: "Express", icon: "express" },
      { name: "Prisma", icon: "prisma" },
      { name: "PostgreSQL", icon: "postgresql" },
    ],
  },
];
---

<BaseLayout title="franqong | Portfolio">
  <Header />

  <main class="container" style="padding-top: 96px; padding-bottom: 64px;">
    <section class="section" id="about">
      <div
        class="flex flex-col md:grid md:grid-layout gap-20 items-start max-w-4xl mx-auto"
      >
        <div class="flex flex-col items-center gap-4 w-full">
          <div class="avatar">
            <img src="/me.webp" alt="Headshot" />
          </div>
          {isAvailableForWork ? (
            <div class="badge-available w-max">
              <span class="dot-ping"></span>
              <span
                class="font-label-mono"
                style="font-size: 10px; white-space: nowrap;"
                data-i18n="hero.available"
                >DISPONIBLE PARA TRABAJAR</span
              >
            </div>
          ) : (
            <div class="badge-unavailable w-max">
              <span class="dot-neutral"></span>
              <span
                class="font-label-mono"
                style="font-size: 10px; white-space: nowrap;"
                data-i18n="hero.unavailable"
                >ACTUALMENTE TRABAJANDO</span
              >
            </div>
          )}
        </div>

        <div class="mt-4 md:mt-0 flex-1">
          <h2 class="font-label-mono text-primary mb-6">
            Franco Garcia
          </h2>
          <h3 class="font-headline-md mb-8" data-i18n="hero.subtitle" style="min-height: 2.4em;">
            Desarrollador de software de alto y bajo nivel.
          </h3>
          <div class="flex flex-col gap-4 font-label-mono text-primary">
            <a
              href="https://www.linkedin.com/in/franco-garcia/"
              target="_blank"
              class="nav-link interactive-el flex items-center gap-2 w-max"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 32 32"
                fill="currentColor"
                ><path
                  d="M28.778 1.004h-25.56c-0.008-0-0.017-0-0.027-0-1.199 0-2.172 0.964-2.186 2.159v25.672c0.014 1.196 0.987 2.161 2.186 2.161 0.010 0 0.019-0 0.029-0h25.555c0.008 0 0.018 0 0.028 0 1.2 0 2.175-0.963 2.194-2.159l0-0.002v-25.67c-0.019-1.197-0.994-2.161-2.195-2.161-0.010 0-0.019 0-0.029 0h0.001zM9.9 26.562h-4.454v-14.311h4.454zM7.674 10.293c-1.425 0-2.579-1.155-2.579-2.579s1.155-2.579 2.579-2.579c1.424 0 2.579 1.154 2.579 2.578v0c0 0.001 0 0.002 0 0.004 0 1.423-1.154 2.577-2.577 2.577-0.001 0-0.002 0-0.003 0h0zM26.556 26.562h-4.441v-6.959c0-1.66-0.034-3.795-2.314-3.795-2.316 0-2.669 1.806-2.669 3.673v7.082h-4.441v-14.311h4.266v1.951h0.058c0.828-1.395 2.326-2.315 4.039-2.315 0.061 0 0.121 0.001 0.181 0.003l-0.009-0c4.5 0 5.332 2.962 5.332 6.817v7.855z"
                ></path></svg
              >
              LinkedIn
            </a>
            <a
              href="https://github.com/franqong"
              target="_blank"
              class="nav-link interactive-el flex items-center gap-2 w-max"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path
                  d="M12 .5C5.73.5.75 5.48.75 11.75c0 5.02 3.25 9.27 7.76 10.77.57.1.78-.25.78-.56
                    0-.28-.01-1.02-.02-2-3.15.7-3.82-1.52-3.82-1.52-.52-1.3-1.26-1.65-1.26-1.65-1.03-.7.08-.69.08-.69
                    1.14.08 1.74 1.17 1.74 1.17 1.01 1.74 2.65 1.24 3.3.95.1-.73.4-1.24.72-1.53-2.52-.29-5.18-1.26-5.18-5.62
                    0-1.24.44-2.25 1.16-3.04-.12-.29-.5-1.45.11-3.02 0 0 .95-.3 3.1 1.16a10.7 10.7 0 0 1 5.64 0
                    c2.15-1.46 3.1-1.16 3.1-1.16.61 1.57.23 2.73.11 3.02.72.79 1.16 1.8 1.16 3.04
                    0 4.37-2.66 5.33-5.2 5.61.41.35.77 1.04.77 2.1 0 1.52-.01 2.75-.01 3.12
                    0 .31.2.67.79.56A11.26 11.26 0 0 0 23.25 11.75C23.25 5.48 18.27.5 12 .5Z"
                ></path>
              </svg>
              GitHub
            </a>
            <a
              href="mailto:garciafranco1998@gmail.com"
              target="_blank"
              class="nav-link interactive-el flex items-center gap-2 w-max"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 512 512"
                fill="currentColor"
              >
                <path
                  d="M440.917,67.925H71.083C31.827,67.925,0,99.752,0,139.008v233.984c0,39.256,31.827,71.083,71.083,71.083
                    h369.834c39.255,0,71.083-31.827,71.083-71.083V139.008C512,99.752,480.172,67.925,440.917,67.925z
                    M178.166,321.72l-99.54,84.92c-7.021,5.992-17.576,5.159-23.567-1.869c-5.992-7.021-5.159-17.576,1.87-23.567
                    l99.54-84.92c7.02-5.992,17.574-5.159,23.566,1.87C186.027,305.174,185.194,315.729,178.166,321.72z
                    M256,289.436c-13.314-0.033-26.22-4.457-36.31-13.183l0.008,0.008l-0.032-0.024c0.008,0.008,0.017,0.008,0.024,0.016
                    L66.962,143.694c-6.98-6.058-7.723-16.612-1.674-23.583c6.057-6.98,16.612-7.723,23.582-1.674l152.771,132.592
                    c3.265,2.906,8.645,5.004,14.359,4.971c5.706,0.017,10.995-2.024,14.44-5.028l0.074-0.065l152.615-132.469
                    c6.971-6.049,17.526-5.306,23.583,1.674c6.048,6.97,5.306,17.525-1.674,23.583l-152.77,132.599
                    C282.211,284.929,269.322,289.419,256,289.436z
                    M456.948,404.771c-5.992,7.028-16.547,7.861-23.566,1.869l-99.54-84.92c-7.028-5.992-7.861-16.546-1.869-23.566
                    c5.991-7.029,16.546-7.861,23.566-1.87l99.54,84.92C462.107,387.195,462.94,397.75,456.948,404.771z"
                ></path>
              </svg>
              Email
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="experiencia">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-label-mono text-primary mb-12 interactive-el" data-i18n="exp.title">
          EXPERIENCIA PROFESIONAL
        </h2>
        <div class="flex flex-col gap-12">
          <div class="flex flex-col md:grid md:grid-layout gap-20">
            <div class="font-label-mono text-on-surface-variant pt-1" data-i18n="exp.present">
              2026 — PRESENTE
            </div>
            <div>
              <h4
                class="font-headline-md mb-2"
                style="font-size: 24px;"
                data-i18n="hero.role"
              >
                Desarrollador Web Full Stack
              </h4>
              <p class="font-body-md text-on-surface-variant">Caudex</p>
            </div>
          </div>

          <div class="staff-line" style="opacity: 0.5;"></div>

          <div class="flex flex-col md:grid md:grid-layout gap-20">
            <div class="font-label-mono text-on-surface-variant pt-1">2024</div>
            <div>
              <h4 class="font-headline-md mb-2" style="font-size: 24px;" data-i18n="exp.sales.role">
                Ventas & Appointment Setting
              </h4>
              <p class="font-body-md text-on-surface-variant">
                Firebrand Agency
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="proyectos">
      <div class="max-w-4xl mx-auto">
        <div class="mb-12">
          <h2 class="font-label-mono text-primary mb-4 interactive-el" data-i18n="proj.title">
            PROYECTOS DESTACADOS
          </h2>
          <h3 class="font-headline-md" data-i18n="proj.subtitle">Productos de software</h3>
        </div>

        <div class="project-grid">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
      </div>
    </section>

    <section class="section" id="sobre-mi">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-label-mono text-primary mb-4 interactive-el" data-i18n="about.title">
          SOBRE MÍ
        </h2>
        <h3 class="font-headline-md mb-12" data-i18n="about.subtitle">
          Full Stack Web & Desktop Developer
        </h3>
        <div class="flex flex-col gap-6 font-body-lg text-on-surface-variant">
          <p data-i18n="about.p1">
            Estudiante en Tecnicatura en Desarrollo de Software, con formación
            en desarrollo web Full Stack y una fuerte orientación práctica
            basada en proyectos reales.
          </p>
          <p data-i18n="about.p2">
            Trabajo activamente en proyectos propios de desarrollo web y
            software de escritorio, además de colaborar en un proyecto web en
            equipo, lo que me permite fortalecer habilidades técnicas y trabajo
            colaborativo.
          </p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</BaseLayout>
